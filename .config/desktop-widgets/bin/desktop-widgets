#!/usr/bin/env bash
# desktop-widgets: Ryoku's desktop widgets, as their own Quickshell instance.
#
#   desktop-widgets            start them (Hyprland runs this at login)
#   desktop-widgets editor     open/close the widget editor (starts them if needed)
#   desktop-widgets enable     turn the widgets on (and start them)
#   desktop-widgets disable    turn the widgets off (and stop them)
#   desktop-widgets status     "on" or "off"
#   desktop-widgets stop       quit (until next login)
#   desktop-widgets restart    stop + start
#   desktop-widgets log        the log
set -euo pipefail

dir="${XDG_CONFIG_HOME:-$HOME/.config}/desktop-widgets"
# Turned off from ArchEclipse Settings: login start is skipped while this exists.
off="${XDG_CONFIG_HOME:-$HOME/.config}/desktop-widgets/settings/widgets-disabled"
# The vendored Ryoku modules (Eclipse.Ui, shell.services, ...) live under qml/.
export QML_IMPORT_PATH="$dir/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"

running() { qs -p "$dir" ipc show >/dev/null 2>&1; }
launch() { running || setsid -f qs -p "$dir" --no-duplicate >/dev/null 2>&1 </dev/null; }
wait_up() { for _ in $(seq 50); do running && return 0; sleep 0.1; done; return 1; }

case ${1-start} in
    start)
        [[ -e $off ]] && exit 0
        launch ;;
    editor)
        # The editor works even while the widgets are off: it is how you turn
        # them back on.
        launch; wait_up
        exec qs -p "$dir" ipc call widgets editor ;;
    enable)
        rm -f "$off"
        if running; then qs -p "$dir" ipc call widgets setEnabled true; else launch; fi ;;
    disable)
        mkdir -p "$(dirname "$off")"; : > "$off"
        # Keep the process while the editor is open (it lives there too).
        if running && [[ $(qs -p "$dir" ipc call widgets editorOpen 2>/dev/null) == true ]]; then
            qs -p "$dir" ipc call widgets setEnabled false
        else
            qs -p "$dir" kill >/dev/null 2>&1 || true
        fi ;;
    status)  [[ -e $off ]] && echo off || echo on ;;
    stop)    qs -p "$dir" kill ;;
    restart) qs -p "$dir" kill >/dev/null 2>&1 || true; sleep 0.3; launch ;;
    log)     exec qs -p "$dir" log ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
