#!/usr/bin/env python3
"""Write ~/.cache/ryoku/wallpaper-tone.json for Ryoku's desktop widgets.

Ryoku's daemon normally publishes this: the wallpaper's CIE L* (lightness) on
an 8x8 grid, the per-cell detail (L* standard deviation) and the frame mean.
The widgets use it to pick light or dark text over the patch they sit on and
to find the calmest spot for auto placement. matugen runs this as a post hook
(~/.config/matugen/config.toml) on every wallpaper change.

    wallpaper-tone [IMAGE]     (default: ~/.cache/current_wallpaper)
"""
import json, os, subprocess, sys

COLS = ROWS = 8
SUB = 8  # samples per cell side, for the detail map

src = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.cache/current_wallpaper")
src = os.path.realpath(src)
out = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "ryoku", "wallpaper-tone.json")

w, h = COLS * SUB, ROWS * SUB
# [0] = first frame of a GIF; Lab's L channel is CIE L* scaled to 0..255.
raw = subprocess.run(
    ["magick", src + "[0]", "-resize", f"{w}x{h}!", "-colorspace", "Lab",
     "-channel", "L", "-separate", "-depth", "8", "gray:-"],
    capture_output=True, check=True, timeout=60).stdout
L = [b * 100 / 255 for b in raw[: w * h]]

grid, detail = [], []
for r in range(ROWS):
    for c in range(COLS):
        cell = [L[(r * SUB + y) * w + c * SUB + x] for y in range(SUB) for x in range(SUB)]
        m = sum(cell) / len(cell)
        grid.append(round(m, 2))
        detail.append(round((sum((v - m) ** 2 for v in cell) / len(cell)) ** 0.5, 2))

os.makedirs(os.path.dirname(out), exist_ok=True)
tmp = out + ".tmp"
with open(tmp, "w") as f:
    json.dump({"lstar": round(sum(L) / len(L), 2), "cols": COLS, "rows": ROWS,
               "grid": grid, "detail": detail}, f)
os.replace(tmp, out)
