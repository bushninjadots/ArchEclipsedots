#!/usr/bin/env python3
"""Fetch GitHub contribution data for the desktop heatmap widget.

Uses the github-contributions-api (jogruber) to get contribution counts per day.
Caches results locally so repeated reads are fast.

    github-contributions [USERNAME] [--year YYYY] [--years] [--force]

If no username given, reads from ~/.cache/desktop-widgets/github/user.txt
Outputs JSON: { "contributions": [{ "date": "YYYY-MM-DD", "count": n }], "total": n, "user": u, "year": y }

Pass --force (-f) to bypass the 24h cache and refetch from the API (the widget's
"Sync now" action uses this).

Pass --year YYYY (default: current year) to graph a specific calendar year.
Pass --years to list the years that have data for the user:
    { "user": u, "years": [ ... ] }
"""
import json, os, sys, urllib.error, urllib.parse, urllib.request, time
from datetime import datetime, timedelta

API_BASE = "https://github-contributions-api.jogruber.de/v4"
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "desktop-widgets", "github")
USER_FILE = os.path.join(CACHE_DIR, "user.txt")

def get(url):
    req = urllib.request.Request(url, headers={"User-Agent": "desktop-widgets (ArchEclipse)"})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)

def cache_path(user, year):
    return os.path.join(CACHE_DIR, f"{user}_{year}.json")

def load_cache(user, year):
    path = cache_path(user, year)
    if os.path.exists(path):
        try:
            with open(path) as f:
                data = json.load(f)
            # Cache expires after 24 hours
            if "cached_at" in data and time.time() - data["cached_at"] < 86400:
                return data
        except (json.JSONDecodeError, OSError):
            pass
    return None

def save_cache(user, year, data):
    os.makedirs(CACHE_DIR, exist_ok=True)
    data["cached_at"] = time.time()
    with open(cache_path(user, year), "w") as f:
        json.dump(data, f)

def fetch_contributions(username, year=None):
    """Fetch contributions for a user, optionally filtered to a year."""
    params = {}
    if year is not None:
        params["y"] = str(year)
    else:
        params["y"] = "last"
    
    url = f"{API_BASE}/{urllib.parse.quote(username)}?" + urllib.parse.urlencode(params)
    return get(url)

def fetch_years(username):
    """Return the sorted list of years that have contribution data for a user."""
    url = f"{API_BASE}/{urllib.parse.quote(username)}"
    data = get(url)
    total = data.get("total")
    if isinstance(total, dict):
        try:
            return sorted(int(k) for k in total)
        except (TypeError, ValueError):
            return []
    return []

def get_current_year():
    return datetime.now().year

def get_system_username():
    """Try to get the system username as a default GitHub username."""
    import getpass
    return getpass.getuser()

def normalize_user(raw):
    """Accept a username, @handle, or a full GitHub URL and return the bare login.

    Examples: "bushninjadots", "@bushninjadots", "github.com/bushninjadots",
    "https://github.com/bushninjadots?tab=overview" -> "bushninjadots".
    """
    if not raw:
        return ""
    s = raw.strip().split("?", 1)[0].split("#", 1)[0].rstrip("/")
    marker = "github.com/"
    idx = s.lower().find(marker)
    if idx != -1:
        s = s[idx + len(marker):]
    s = s.split("/", 1)[0]  # drop any repo/tab path segments
    return s.lstrip("@").strip()

def parse_args():
    """Return (username_arg, year, years_only, force). Flags may appear before or after the user."""
    user = None
    year = None
    years_only = False
    force = False
    args = sys.argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-f", "--force"):
            force = True
        elif a == "--years":
            years_only = True
        elif a == "--year":
            if i + 1 < len(args):
                i += 1
                try:
                    year = int(args[i])
                except ValueError:
                    year = None
        elif user is None:
            user = a
        i += 1
    return user, year, years_only, force

def resolve_user(cli_user=None):
    """Resolve which GitHub user to fetch for."""
    # 1. Command line arg
    if cli_user:
        return normalize_user(cli_user)
    
    # 2. Stored user file
    if os.path.exists(USER_FILE):
        try:
            with open(USER_FILE) as f:
                user = normalize_user(f.read().strip())
                if user:
                    return user
        except OSError:
            pass
    
    # 3. System username as fallback
    return get_system_username()

def main():
    user_arg, year_arg, years_only, force = parse_args()
    username = resolve_user(user_arg)
    
    if not username:
        print(json.dumps({"contributions": [], "total": 0, "error": "no_username"}))
        sys.exit(0)
    
    # --years: list the years that have data for this user (cached 24h)
    if years_only:
        if not force:
            cached = load_cache(username, "years")
            if cached and "years" in cached:
                print(json.dumps(cached))
                return
        try:
            years = fetch_years(username)
            result = {"user": username, "years": years}
            save_cache(username, "years", result)
            print(json.dumps(result))
        except urllib.error.HTTPError as e:
            if e.code == 404:
                print(json.dumps({"user": username, "years": [], "error": "user_not_found"}))
            elif e.code == 429:
                print(json.dumps({"user": username, "years": [], "error": "rate_limited"}))
            else:
                print(json.dumps({"user": username, "years": [], "error": "http_error", "code": e.code}))
        except (urllib.error.URLError, OSError, TimeoutError):
            print(json.dumps({"user": username, "years": [], "error": "network_error"}))
        except Exception as e:
            print(json.dumps({"user": username, "years": [], "error": "unknown", "message": str(e)}))
        return
    
    year = year_arg if year_arg is not None else get_current_year()
    
    # Try cache first (a manual --force sync skips this and hits the API)
    if not force:
        cached = load_cache(username, year)
        if cached and "contributions" in cached:
            print(json.dumps(cached))
            return
    
    # Fetch from API
    try:
        data = fetch_contributions(username, year)
        
        # Normalize the response
        contributions = []
        total = 0
        
        if "contributions" in data:
            for c in data["contributions"]:
                date = c.get("date", "")
                count = c.get("count", 0)
                if date:
                    contributions.append({"date": date, "count": count})
                    total += count
        
        # Get total for the year
        if "total" in data:
            total_data = data["total"]
            if isinstance(total_data, dict):
                total = total_data.get(str(year), total_data.get(year, total))
            elif isinstance(total_data, (int, float)):
                total = int(total_data)
        
        result = {
            "contributions": contributions,
            "total": total,
            "user": username,
            "year": year
        }
        
        save_cache(username, year, result)
        print(json.dumps(result))
        
    except urllib.error.HTTPError as e:
        if e.code == 404:
            print(json.dumps({"contributions": [], "total": 0, "error": "user_not_found", "user": username}))
        elif e.code == 429:
            # Rate limited - try cache even if stale
            cached_stale = load_cache(username, year)
            if cached_stale and "contributions" in cached_stale:
                print(json.dumps(cached_stale))
            else:
                print(json.dumps({"contributions": [], "total": 0, "error": "rate_limited"}))
        else:
            print(json.dumps({"contributions": [], "total": 0, "error": "http_error", "code": e.code}))
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        # Network error - try cache even if stale
        cached_stale = load_cache(username, year)
        if cached_stale and "contributions" in cached_stale:
            print(json.dumps(cached_stale))
        else:
            print(json.dumps({"contributions": [], "total": 0, "error": "network_error"}))
    except Exception as e:
        print(json.dumps({"contributions": [], "total": 0, "error": "unknown", "message": str(e)}))

if __name__ == "__main__":
    main()
